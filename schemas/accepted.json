{
  "entity": "accepted",
  "template": {
    "path": "templates/accepted.md"
  },
  "fields": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "example": "标题"
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": true,
      "example": "一句话说明核心价值"
    },
    {
      "name": "canonical_url",
      "type": "url",
      "required": true,
      "example": "https://example.com/dataset"
    },
    {
      "name": "domain",
      "type": "string",
      "required": true,
      "example": "领域"
    },
    {
      "name": "content_type",
      "type": "string",
      "required": true,
      "example": "内容类型"
    },
    {
      "name": "data_form",
      "type": "string",
      "required": true,
      "example": "数据形态"
    },
    {
      "name": "data_type",
      "type": "string",
      "required": true,
      "example": "数据类型"
    },
    {
      "name": "region",
      "type": "string",
      "required": true,
      "example": "不明/待确认"
    },
    {
      "name": "source_type",
      "type": "string",
      "required": true,
      "example": "来源类型"
    },
    {
      "name": "source_org",
      "type": "string",
      "required": true,
      "example": "来源机构"
    },
    {
      "name": "permissions",
      "type": "string",
      "required": true,
      "example": "不明"
    },
    {
      "name": "tags",
      "type": "inline_array",
      "required": true,
      "example": "[标签1, 标签2]"
    },
    {
      "name": "use_cases",
      "type": "inline_array",
      "required": true,
      "example": "[用途1, 用途2]"
    }
  ]
}
