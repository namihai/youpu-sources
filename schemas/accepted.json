{
  "entity": "accepted",
  "template": {
    "path": "templates/accepted.md"
  },
  "fields": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "example": "标题"
    },
    {
      "name": "summary",
      "type": "string",
      "required": true,
      "example": "一句话客观描述这个来源是什么"
    },
    {
      "name": "canonical_url",
      "type": "url",
      "required": true,
      "example": "https://example.com/dataset"
    },
    {
      "name": "publisher",
      "type": "string",
      "required": true,
      "example": "发布或维护该来源的主体"
    },
    {
      "name": "modality",
      "type": "string",
      "required": true,
      "example": "text",
      "choices": ["text", "image", "audio", "video", "tabular", "geospatial", "multimodal", "other"]
    },
    {
      "name": "access_level",
      "type": "string",
      "required": true,
      "example": "open",
      "choices": ["open", "request", "restricted", "unknown"]
    },
    {
      "name": "tags",
      "type": "inline_array",
      "required": false,
      "example": "[标签1, 标签2]"
    }
  ]
}
